# Deploy do Planning Poker (VPS)
# Copie para .env no servidor e preencha.

# Dominio que aponta para a VPS (Caddy interno serve HTTP; TLS fica no proxy de borda)
SITE_DOMAIN=poker.seudominio.com

# URL wss usada no build do frontend (mesmo dominio, https)
SITE_URL_WSS=wss://poker.seudominio.com

# CORS do backend (origens do site, separadas por virgula)
ALLOWED_ORIGINS=https://poker.seudominio.com

# Porta HTTP exposta na VPS (se o proxy de borda apontar para outra, ajuste)
WEB_PORT=8080
